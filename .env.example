# Copy this file to `.env` in the repo root and fill in real values.
# Never commit the real `.env` — it's gitignored via `*.env`.

SECRET_KEY=change-me-to-a-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave unset locally to use the zero-setup sqlite fallback.
# In production (Render), set this to your Neon Postgres connection string:
# DATABASE_URL=postgresql://user:password@host/dbname

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/google-callback/
FRONTEND_URL=http://localhost:5173
FRONTEND_HOME_URL=http://localhost:5173/home

# Gmail SMTP for sending OTP emails (use an App Password, not your real password)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Razorpay (dashboard.razorpay.com > Settings > API Keys) — use TEST keys for the public demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary (cloudinary.com dashboard) — used for photo storage in production
CLOUDINARY_URL=
